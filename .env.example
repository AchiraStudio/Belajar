# Copy to `.env` (git-ignored) and fill in. Server-side secrets only; nothing here may reach a client bundle.

# Supabase project "stuby" (tvkgmepboviwgpbqddym), region ap-south-1.
# Connect as the restricted `belajar_app` role (no BYPASSRLS) through the SESSION pooler, port 5432.
# Never use the `postgres` or `service_role` credentials for this connection: both bypass RLS.
DATABASE_URL=postgresql://belajar_app.tvkgmepboviwgpbqddym:<belajar_app password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Leave unset for Supabase: the schema is applied as a Supabase migration. Only set it for a plain
# local Postgres (`cargo run -p belajar-devdb` prints one) so the sqlx migrator creates the schema.
# DATABASE_ADMIN_URL=

# Owner login (minimum 8 characters), or APP_PASSWORD_HASH with an Argon2 hash instead.
APP_PASSWORD=

HOST=127.0.0.1
PORT=8080
TIMEZONE=Asia/Jakarta
# COOKIE_SECURE=1   # behind HTTPS
# TRUST_PROXY=1     # behind Caddy/nginx
