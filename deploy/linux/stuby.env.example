# Pengaturan server Stuby di Linux. install.sh menyalin berkas ini ke /etc/stuby/stuby.env
# (izin 640, pemilik root:stuby). Isi DATABASE_URL dan satu dari APP_PASSWORD / APP_PASSWORD_HASH.

# --- Jaringan -------------------------------------------------------------------------------
# Server hanya mendengarkan di loopback; Caddy (lihat Caddyfile.example) yang menghadap internet.
HOST=127.0.0.1
PORT=8080

# Di belakang Caddy/HTTPS: biarkan 1. Cookie "Secure" TIDAK dikirim lewat http polos, jadi kalau
# mau mencoba lewat http://alamat:8080 tanpa Caddy, ubah COOKIE_SECURE ke 0 sementara.
COOKIE_SECURE=1
TRUST_PROXY=1
SESSION_DAYS=30

# --- Lokasi (diisi install.sh, jangan diubah kecuali memindahkan folder) -----------------------
STATIC_DIR=/opt/stuby/web
FILES_DIR=/var/lib/stuby/files

# --- Database Supabase -------------------------------------------------------------------------
# Session pooler (port 5432), peran terbatas `belajar_app`. Jangan pakai `postgres`/`service_role`:
# keduanya melewati row-level security.
DATABASE_URL=postgresql://belajar_app.<ref-proyek>:<kata-sandi>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- Login pemilik (minimal 8 karakter) ----------------------------------------------------------
APP_PASSWORD=
# Atau pakai hash Argon2 (menggantikan APP_PASSWORD bila diisi):
# APP_PASSWORD_HASH=

# --- Lain-lain ---------------------------------------------------------------------------------
TIMEZONE=Asia/Jakarta
DAY_START_HOUR=0
MAX_UPLOAD_MB=40
JOB_WORKERS=2
