# Salin ke /etc/systemd/system/belajar.service, sesuaikan path dan user, lalu:
#   sudo systemctl daemon-reload && sudo systemctl enable --now belajar
[Unit]
Description=Belajar - server web dan bridge
After=network.target

[Service]
WorkingDirectory=/opt/belajar/server
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
User=belajar
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
