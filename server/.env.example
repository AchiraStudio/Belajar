# Salin menjadi .env lalu isi nilainya.
# Buat nilai acak dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Wajib diisi ---
PORT=9990
APP_PASSWORD=ganti-dengan-password-login-yang-kuat
SESSION_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter
BRIDGE_TOKEN=ganti-dengan-token-acak-panjang-minimal-32-karakter

# --- Opsional ---
# MAX_UPLOAD_MB=40
# SESSION_DAYS=30

# CATATAN: COOKIE_SECURE dan TRUST_PROXY hanya diperlukan bila
# memakai reverse proxy (Caddy/nginx) dengan HTTPS.
# Untuk HTTP langsung (tanpa proxy), biarkan tidak diisi.
