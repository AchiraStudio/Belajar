+            aligns = []
+            for k in range(n):
+                c = sep_old[k].replace(" ", "") if k < len(sep_old) else "---"
+                left, right = c.startswith(":"), c.endswith(":")
+                aligns.append((":" if left else "") + "---" + (":" if right else ""))
+            if out and out[-1].strip():
+                out.append("")
+            out.append("| " + " | ".join(header) + " |")
+            out.append("|" + "|".join(aligns) + "|")
+            i += 2
