+/* layar penuh ("canvas") */
+.code-canvas.cc-full { position: fixed; inset: 0; z-index: 120; border-radius: 0; border: 0; display: flex; flex-direction: column; max-width: none; margin: 0; }
+.code-canvas.cc-full .cc-pre { flex: 1 1 auto; max-height: none; -webkit-mask-image: none; mask-image: none; padding: 16px 0; font-size: 14.5px; overflow: auto; }
+.code-canvas.cc-full.cc-collapsed .cc-pre { max-height: none; -webkit-mask-image: none; mask-image: none; }
+.code-canvas.cc-full .cc-more { display: none; }
+body.cc-lock { overflow: hidden; }
+@media (max-width: 520px) { .cc-pre { font-size: 12.5px; } .cc-btn { padding: 6px 8px; } .cc-bar { padding-left: 12px; } }
+@media print {
+  .code-canvas { background: #fff; border-color: #999; break-inside: avoid; }
+  .cc-bar .cc-actions, .cc-more { display: none !important; }
+  .cc-collapsed .cc-pre { max-height: none; -webkit-mask-image: none; mask-image: none; }
+  .cc-pre, .cc-pre code, .cl { color: #000 !important; white-space: pre-wrap; }
+  .t-k, .t-s, .t-c, .t-n, .t-f, .t-t, .t-b { color: #000; font-weight: 600; }
+}
