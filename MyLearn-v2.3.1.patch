+    cells: list[str] = []
+    cur: list[str] = []
+    in_math = False
+    i = 0
+    while i < len(s):
+        ch = s[i]
+        if ch == "\\" and i + 1 < len(s):
+            cur.append(s[i:i + 2])
+            i += 2
+            continue
+        if ch == "$" and track_math:
+            in_math = not in_math
+        if ch == "|" and not in_math:
+            cells.append("".join(cur).strip())
+            cur = []
+        else:
