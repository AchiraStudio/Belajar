+def _split_cells(line: str) -> list[str]:
+    """Pecah baris tabel Markdown menjadi sel; `|` di dalam $...$ atau `\\|` bukan pemisah."""
+    s = line.strip()
+    if s.startswith("|"):
+        s = s[1:]
+    if s.endswith("|") and not s.endswith("\\|"):
+        s = s[:-1]
